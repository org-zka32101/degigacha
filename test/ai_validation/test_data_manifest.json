      "minConfidence": 0.80,
      "imageCondition": "normal",
      "notes": "High quality image, clear item"
    },
    {
      "id": "002",
      "imagePath": "test/ai_validation/test_images/sample_002.jpg",
      "expectedName": "Character/Item Name",
      "expectedSeries": "Series Name",
      "expectedRarity": "SR",
      "minConfidence": 0.75,
      "imageCondition": "blurry",
      "notes": "Slightly blurry, common edge case"
    },
    {
      "id": "003",
      "imagePath": "test/ai_validation/test_images/sample_003.jpg",
      "expectedName": "Character/Item Name",
      "expectedSeries": "Series Name",
